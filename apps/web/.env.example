# Every environment variable the web app reads, with a safe default or placeholder.
#
# Checked in on purpose; `.env` and `.env.local` are not (see .gitignore).
# Keep this file in step with the code: every import.meta.env.VITE_* reference
# in the source must appear here.

# Base URL of the API service (no trailing slash).
VITE_API_URL=http://localhost:3000

# Stripe publishable key — safe to expose in the browser.
# Use a test key (pk_test_…) for development and staging; never commit a live key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
