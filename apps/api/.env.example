# Every environment variable this service reads, with a safe default or a blank.
#
# Checked in on purpose; `.env` is not (see .gitignore). Keep this file in step with the
# code: the orchestrator's `env-example-complete` check diffs every `process.env.X`
# reference against these keys, and it is the FILE existing that turns that check on.
PORT=3000
# Stripe secret key (from the Stripe Dashboard → Developers → API keys).
# Use a test key (sk_test_…) for development and staging; never commit a live key.
STRIPE_SECRET_KEY=sk_test_replace_me
